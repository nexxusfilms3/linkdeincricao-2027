{
  "entities": {
    "Registration": {
      "title": "Registration",
      "description": "Inscrição de participante para o projeto online Meu 2027 com Propósito",
      "type": "object",
      "properties": {
        "fullName": {
          "type": "string",
          "description": "Nome completo da participante",
          "minLength": 2,
          "maxLength": 120
        },
        "whatsapp": {
          "type": "string",
          "description": "Número de WhatsApp com DDD",
          "minLength": 8,
          "maxLength": 25,
          "pattern": "^[0-9+()\\s\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "E-mail da participante para envio do e-book e orientações",
          "minLength": 5,
          "maxLength": 160,
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
        },
        "cityState": {
          "type": "string",
          "description": "Cidade e estado (opcional)",
          "maxLength": 100
        },
        "expectation": {
          "type": "string",
          "description": "Principal objetivo ou propósito para 2027 (opcional)",
          "maxLength": 500
        },
        "status": {
          "type": "string",
          "enum": ["confirmada", "no_grupo"],
          "description": "Status da inscrição no fluxo de entrada para o grupo"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp do servidor no momento da inscrição"
        }
      },
      "required": ["fullName", "whatsapp", "email", "status", "createdAt"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Usuária ou administrador autorizado a visualizar e gerenciar inscrições",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 160
        },
        "name": {
          "type": "string",
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["email", "createdAt"]
    }
  },
  "firestore": {
    "/registrations/{registrationId}": {
      "schema": { "$ref": "#/entities/Registration" },
      "description": "Armazena as inscrições enviadas pelo formulário público do projeto Meu 2027 com Propósito"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Lista de administradores autorizados a acessar o painel de inscritas"
    }
  }
}
